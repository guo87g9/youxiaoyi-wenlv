.passport {
  margin: 24rpx; padding: 30rpx 28rpx 26rpx;
  background: linear-gradient(150deg, #8E2A1F, #B93A2B);
  border-radius: 22rpx; color: #FBF3E4;
  box-shadow: 0 10rpx 26rpx rgba(142,42,31,.2);
}
.pp-title { font-size: 32rpx; font-weight: 700; letter-spacing: 2rpx; }
.pp-sub { font-size: 21rpx; opacity: .88; margin-top: 10rpx; line-height: 1.6; }
.progress { height: 10rpx; background: rgba(255,255,255,.25); border-radius: 999rpx; margin-top: 22rpx; overflow: hidden; }
.progress .bar { height: 100%; background: #C9A254; border-radius: 999rpx; transition: width .35s; }
.pp-num { font-size: 20rpx; margin-top: 12rpx; opacity: .9; }

.grid { display: flex; flex-wrap: wrap; padding: 0 16rpx; }
.stamp {
  width: 33.33%; box-sizing: border-box; padding: 8rpx;
}
.stamp .s-ico {
  height: 140rpx; background: #FFFDF7; border: 2rpx dashed #D9CBB0;
  border-radius: 18rpx; display: flex; align-items: center;
  justify-content: center; font-size: 52rpx; color: #C3B79F;
  filter: grayscale(1); opacity: .7;
}
.stamp .s-nm { display: block; text-align: center; font-size: 20rpx; color: #9C9284; margin-top: 8rpx; }
.stamp.got .s-ico {
  border: 2rpx solid #8E2A1F; background: #FBF1EC;
  filter: none; opacity: 1; transform: rotate(-3deg);
}
.stamp.got .s-nm { color: #8E2A1F; font-weight: 700; }

.reward {
  margin: 20rpx 24rpx; background: #FFF6E8;
  border: 2rpx dashed #C9A254; border-radius: 20rpx;
  padding: 26rpx; text-align: center;
}
.reward .r-ico { font-size: 56rpx; }
.reward .r-t { font-size: 26rpx; font-weight: 700; color: #8E2A1F; margin-top: 10rpx; }
.reward .r-p { font-size: 21rpx; color: #8A6A1F; line-height: 1.7; margin-top: 10rpx; }
.reset { text-align: center; font-size: 21rpx; color: #A79C8C; margin: 30rpx 0 10rpx; text-decoration: underline; }
