.g-page {
  display: flex; flex-direction: column;
  height: 100vh; background: #F7F1E4;
}
.persona-bar {
  white-space: nowrap; padding: 18rpx 20rpx 12rpx;
  box-sizing: border-box; height: 168rpx;
}
.persona {
  display: inline-block; width: 148rpx; margin-right: 14rpx;
  text-align: center; background: #FFFDF7; border-radius: 18rpx;
  padding: 14rpx 4rpx; border: 3rpx solid transparent;
  box-shadow: 0 4rpx 12rpx rgba(43,43,43,.05);
}
.persona .av {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  margin: 0 auto 8rpx; display: flex; align-items: center;
  justify-content: center; font-size: 34rpx; color: #fff;
}
.persona .pname { font-size: 20rpx; color: #8A7A63; }
.persona.on { border-color: #8E2A1F; background: #FBF1EC; }
.persona.on .pname { color: #8E2A1F; font-weight: 700; }

.chat-box {
  flex: 1; display: flex; flex-direction: column;
  margin: 0 20rpx; background: #FFFDF7;
  border-radius: 20rpx; overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(90,60,30,.07);
}
.chat-head {
  display: flex; align-items: center; padding: 18rpx 22rpx;
  border-bottom: 1rpx solid #F0EADA;
}
.chat-head .dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #3BB273; margin-right: 10rpx; }
.chat-head .ctitle { font-size: 25rpx; font-weight: 700; }
.chat-head .ctag { margin-left: auto; font-size: 19rpx; color: #A79C8C; }

.chat-body { flex: 1; padding: 18rpx; box-sizing: border-box; }
.msg { max-width: 84%; padding: 16rpx 20rpx; border-radius: 18rpx; margin-bottom: 16rpx; }
.msg.ai { background: #F6EEE0; border-top-left-radius: 6rpx; }
.msg.me { background: #8E2A1F; margin-left: auto; border-top-right-radius: 6rpx; }
.msg .who { font-size: 19rpx; color: #2F6E63; font-weight: 700; margin-bottom: 6rpx; }
.msg .txt { font-size: 24rpx; line-height: 1.75; word-break: break-all; }
.msg.me .txt { color: #FBF3E4; }
.msg .replay {
  margin-top: 10rpx; display: inline-block;
  background: #FFFDF7; border: 1rpx solid #E4D9C0; color: #2F6E63;
  font-size: 20rpx; padding: 4rpx 16rpx; border-radius: 999rpx;
}
.suggest {
  white-space: nowrap; padding: 12rpx 16rpx;
  border-top: 1rpx solid #F0EADA; box-sizing: border-box;
}
.chip {
  display: inline-block; background: #F7F1E4;
  border: 1rpx solid #E4D9C0; border-radius: 999rpx;
  font-size: 21rpx; padding: 8rpx 20rpx; margin-right: 10rpx;
  color: #4A4238;
}
.input-row {
  display: flex; align-items: center;
  padding: 14rpx 16rpx; border-top: 1rpx solid #F0EADA;
}
.ipt {
  flex: 1; background: #F7F1E4; border: 1rpx solid #E4D9C0;
  border-radius: 999rpx; padding: 0 22rpx; height: 64rpx;
  font-size: 23rpx;
}
.send {
  margin: 0 0 0 12rpx; height: 64rpx; line-height: 64rpx;
  background: #8E2A1F; color: #FBF3E4; font-size: 23rpx;
  border-radius: 999rpx; padding: 0 26rpx;
}
.send::after { border: none; }

.voice-btn {
  display: flex; align-items: center;
  margin: 14rpx 20rpx 18rpx; padding: 16rpx 22rpx;
  background: #FFFDF7; border-radius: 18rpx;
  border: 2rpx solid transparent;
  box-shadow: 0 4rpx 14rpx rgba(90,60,30,.06);
}
.voice-btn.on { border-color: #C9A254; }
.voice-btn .vico {
  width: 62rpx; height: 62rpx; border-radius: 50%;
  background: #2F6E63; color: #fff; font-size: 28rpx;
  display: flex; align-items: center; justify-content: center;
  margin-right: 16rpx; flex-shrink: 0;
}
.voice-btn .vb { display: block; font-size: 24rpx; font-weight: 700; }
.voice-btn .vtip { display: block; font-size: 20rpx; color: #9C9284; margin-top: 4rpx; line-height: 1.5; }
