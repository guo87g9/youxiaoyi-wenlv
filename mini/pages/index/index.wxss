.cat-bar { white-space: nowrap; padding: 6rpx 24rpx 10rpx; box-sizing: border-box; }
.cat-chip {
  display: inline-block; background: #FFFDF7; border: 1rpx solid #E4D9C0;
  border-radius: 999rpx; padding: 10rpx 22rpx; font-size: 21rpx;
  margin-right: 12rpx; color: #5B5347;
}
.cat-chip.on { background: #8E2A1F; border-color: #8E2A1F; color: #FBF3E4; font-weight: 600; }
.tag {
  display: inline-block; font-size: 18rpx; padding: 2rpx 10rpx;
  border-radius: 8rpx; background: #F3EADA; color: #8A6A1F; margin-bottom: 4rpx;
}
.tag.hist { background: #F6E7E2; color: #8E2A1F; }
.tag.museum { background: #E9F0F6; color: #3D5A8F; }
.tag.nature { background: #E6F1EE; color: #2F6E63; }
.tag.food { background: #FBF0DC; color: #A5813B; }
